#!/usr/bin/env bash

ALIASES_DIR=".direnv/aliases"

export_function() {
    local name=$1
    local alias_dir=$PWD/${ALIASES_DIR}
    mkdir -p "$alias_dir"
    PATH_add "$alias_dir"
    local target="$alias_dir/$name"
    if declare -f "$name" >/dev/null; then
        echo "#!/usr/bin/env bash" > "$target"
        declare -f "$name" >> "$target" 2>/dev/null
        echo "$name" '"$@"' >> "$target"
        chmod +x "$target"
    fi
}

clear_direnv_aliases() {
    local alias_dir="$PWD/${ALIASES_DIR}"
    # 引用符が要る。パスに空白が入ると `rm -rf /path/to/my app/...` と
    # 割れて、手前の "my" を別の引数として消しにいく。-f がそのエラーを
    # 隠すので気づけない。direnv は bash で評価するので、zsh 側の
    # `alias rm='trash'` は効かない。
    rm -rf "${alias_dir:?}"/*
}
