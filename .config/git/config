[init]
    defaultBranch = main

[core]
	pager = hunk pager
    autocrlf = input
    precomposeunicode = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true

[url "ssh://git@github.com/"]
    pushInsteadOf = https://github.com/
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
