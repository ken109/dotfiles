[user]
    name = Kensuke Kubo
    email = kensuke.kubo@ken109.dev

[init]
    defaultBranch = main

[core]
	pager = hunk pager
    autocrlf = input
    precomposeunicode = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    syntax-theme = tokyonight_night
    minus-style = syntax "#3f2d3d"
    minus-emph-style = syntax "#763842"
    plus-style = syntax "#283b4d"
    plus-emph-style = syntax "#316172"

[url "ssh://git@github.com/"]
    pushInsteadOf = https://github.com/
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://lfs.ken109.dev"]
	helper = 
	helper = !sh "$HOME/.config/r2-lfs/credential"
	useHttpPath = true
[r2-lfs]
	server = https://lfs.ken109.dev
[lfs "customtransfer.r2-lfs-multipart"]
	path = r2-lfs
	args = transfer-agent
	concurrent = true
	direction = upload
