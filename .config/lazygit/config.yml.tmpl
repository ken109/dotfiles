git:
  # lazygit 0.5x で git.pagers -> git.diffRenderers、pager -> command に
  # 変わった。古い名前でも起動はするが、lazygit が自動移行して設定ファイルを
  # 書き戻そうとする。生成物は読み取り専用なので書き込みに失敗し、TUI が
  # 立ち上がらない。しかもエラーは権限の話に見えるので、原因が名前の方だと
  # 分からない。
  diffRenderers:
    - colorArg: always
      command: delta --dark --paging=never

gui:
  sidePanelWidth: 0.20
  # tokyonight (night) — 単一ソース: theme.toml (sennit render が生成する)
  # 選択行は既存の方針どおり背景塗りではなく underline のままにしている。
  theme:
    activeBorderColor:
      - "{{ accent.primary }}"
      - bold
    inactiveBorderColor:
      - "{{ ui.comment }}"
    searchingActiveBorderColor:
      - "{{ normal.yellow }}"
    optionsTextColor:
      - "{{ normal.blue }}"
    selectedLineBgColor:
      - underline
    cherryPickedCommitFgColor:
      - "{{ normal.magenta }}"
    cherryPickedCommitBgColor:
      - "{{ ui.selection }}"
    unstagedChangesColor:
      - "{{ normal.red }}"
    defaultFgColor:
      - "{{ ui.fg }}"

refresher:
  refreshInterval: 3

os:
  editPreset: "nvim-remote"
