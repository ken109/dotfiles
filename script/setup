#!/usr/bin/env bash

# pipefail が無いと `curl ... | bash` が curl の失敗を捨てる。bash は空の
# 標準入力を読んで 0 で終わるので、ネットワークが落ちていても「入れた」と
# 表示されたまま先へ進む。
set -euo pipefail

USER="${USER:-$(whoami)}"

# 必須でない工程の失敗をためておく。落ちた事実は捨てないが、その場で
# 中断はしない。第三者のインストーラが落ちたせいで dotfiles が 1 つも
# 配置されない、というのが最悪の結果なので。
FAILED_STEPS=()

# Load utilities
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/utils.sh"

OS="$(uname -s)"

# --------------------------------------------------------------------------------------------------
#  Helper Functions
# --------------------------------------------------------------------------------------------------

load_brew() {
    if [ "$OS" = "Darwin" ]; then
        if [ -f "/opt/homebrew/bin/brew" ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -f "/usr/local/bin/brew" ]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    elif [ "$OS" = "Linux" ]; then
        if [ -d "/home/linuxbrew/.linuxbrew" ]; then
            eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        elif [ -d "$HOME/.linuxbrew" ]; then
            eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
        fi
    fi
}

# --------------------------------------------------------------------------------------------------
#  Installation Functions
# --------------------------------------------------------------------------------------------------

install_system_dependencies() {
    if [ "$OS" != "Linux" ]; then
        return
    fi

    # sennit 自体を動かす前に必要な最低限だけをここで入れる。
    # 残りは packages.toml の宣言から sennit sync が入れる。
    e_section "System Dependencies"

    if has_command apt-get; then
        e_header "Installing apt bootstrap packages..."
        export DEBIAN_FRONTEND=noninteractive
        sudo apt-get update
        sudo apt-get install -y build-essential curl file git procps
    elif has_command yay; then
        e_header "Installing yay bootstrap packages..."
        yay -Syu --noconfirm
        yay -S --noconfirm base-devel curl file git procps-ng
    fi

    e_done "System dependencies installed"
}

install_homebrew() {
    e_section "Homebrew Setup"
    if ! has_command brew; then
        e_header "Installing Homebrew..."
        # Set CI=1 to avoid interactive prompt
        CI=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"

        load_brew
        e_done "Homebrew installed"
    else
        load_brew
        e_header "Homebrew already installed"
    fi
}

install_packages() {
    e_section "Package Installation"

    brew update

    # sennit 自身は sennit sync では入れられないので、ここだけ直接入れる
    e_header "Installing sennit..."
    brew tap ken109/tap
    # Homebrew は非公式 tap の formula を明示的に trust しないと読み込まない
    brew trust --tap ken109/tap
    brew install sennit

    # 残りは packages.toml の宣言から sennit が入れる。
    # 何をどのマネージャで入れるかは packages.toml が唯一のソース。
    e_header "Installing declared packages via sennit..."
    (cd "$SCRIPT_DIR/.." && sennit sync)

    e_done "Packages installed"
}

install_viteplus() {
    e_section "Vite Plus"
    e_header "Installing vite.plus..."
    # 外部のインストーラなので落ちうる。落ちても配置は続け、最後にまとめて
    # 失敗として返す。pipefail のおかげで curl の失敗がここまで届く。
    if curl -fsSL https://vite.plus | bash; then
        e_done "vite.plus installed"
    else
        e_error "vite.plus installer failed"
        FAILED_STEPS+=("vite.plus")
    fi
}

# --------------------------------------------------------------------------------------------------
#  Configuration Functions
# --------------------------------------------------------------------------------------------------

install_docker() {
    if [ "$OS" != "Linux" ]; then
        return
    fi

    e_section "Docker Installation"

    if has_command docker; then
        e_header "Docker already installed"
        return
    fi

    if has_command apt-get; then
        e_header "Installing Docker via apt..."
        export DEBIAN_FRONTEND=noninteractive

        sudo install -m 0755 -d /etc/apt/keyrings
        sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
        sudo chmod a+r /etc/apt/keyrings/docker.asc

        # shellcheck disable=SC1091
        sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<HEREDOC
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
HEREDOC

        sudo apt-get update
        sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

        e_done "Docker installed"
    fi
}

configure_shell() {
    e_section "Shell Configuration"
    e_header "Configuring zsh..."

    local zsh_path
    zsh_path="$(brew --prefix)/bin/zsh"

    if [ ! -x "$zsh_path" ]; then
        e_warning "Homebrew zsh not found, falling back to system zsh"
        # 実在するものだけを採る。無いパスのまま進むと、/etc/shells に
        # 存在しないシェルを足して chsh し、ログインできない状態を作る。
        zsh_path=""
        for candidate in /bin/zsh /usr/bin/zsh; do
            if [ -x "$candidate" ]; then
                zsh_path="$candidate"
                break
            fi
        done
        if [ -z "$zsh_path" ]; then
            e_error "no zsh found; leaving the login shell alone"
            FAILED_STEPS+=("zsh")
            return 0
        fi
    fi

    # Add to /etc/shells if not present
    if ! grep -q "$zsh_path" /etc/shells; then
        e_header "Adding $zsh_path to /etc/shells..."
        echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi

    # Change shell
    if [ "$SHELL" != "$zsh_path" ]; then
        e_header "Changing shell to $zsh_path..."
        sudo chsh -s "$zsh_path" "$USER"
    fi

    e_done "Shell configured"
}

configure_mise() {
    e_section "Tool Configuration"
    e_header "Configuring mise..."

    if has_command mise; then
        e_header "mise is installed. Basic configuration assumed via dotfiles."
    else
        e_warning "mise command not found, skipping configuration"
        return
    fi

    e_done "mise configured"
}

configure_tpm() {
    e_header "Configuring tpm..."
    if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
        git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
        e_done "tpm installed"
    else
        e_done "tpm already installed"
    fi
}

# GNOME (Wayland): enable the Alacritty toggle extension and bind Super+Shift+Return
# to it. This replaces the X11-only `tdrop`, which cannot toggle native Wayland
# windows. The extension itself is deployed as a symlink under
# ~/.local/share/gnome-shell/extensions by the deploy script.
configure_gnome() {
    if [ "$OS" != "Linux" ]; then
        return
    fi

    if ! has_command gnome-extensions || ! has_command gsettings; then
        return
    fi

    e_section "GNOME Configuration"

    local uuid="alacritty-toggle@ken109"

    e_header "Enabling GNOME extension: $uuid..."
    # A brand-new extension is unknown to the already-running shell, so
    # `gnome-extensions enable` fails on Wayland (no hot rescan). Fall back to
    # writing the enabled-extensions key directly; the shell picks it up on the
    # next login.
    if gnome-extensions enable "$uuid" 2>/dev/null; then
        e_done "Extension enabled"
    else
        local enabled
        enabled="$(gsettings get org.gnome.shell enabled-extensions)"
        if [[ "$enabled" != *"'$uuid'"* ]]; then
            if [ "$enabled" = "@as []" ] || [ "$enabled" = "[]" ]; then
                gsettings set org.gnome.shell enabled-extensions "['$uuid']"
            else
                gsettings set org.gnome.shell enabled-extensions "${enabled%]*}, '$uuid']"
            fi
        fi
        e_warning "Extension queued; it activates after the next login (log out/in)."
    fi

    e_header "Binding Super+Shift+Return to the terminal toggle..."
    local schema="org.gnome.settings-daemon.plugins.media-keys"
    local kb_path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/alacritty-toggle/"
    local kb_schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:$kb_path"

    # Register the custom keybinding path (idempotent).
    local current
    current="$(gsettings get "$schema" custom-keybindings)"
    if [[ "$current" != *"$kb_path"* ]]; then
        if [ "$current" = "@as []" ] || [ "$current" = "[]" ]; then
            gsettings set "$schema" custom-keybindings "['$kb_path']"
        else
            gsettings set "$schema" custom-keybindings "${current%]*}, '$kb_path']"
        fi
    fi

    gsettings set "$kb_schema" name "Alacritty Toggle"
    gsettings set "$kb_schema" command "/usr/bin/gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell/Extensions/AlacrittyToggle --method org.gnome.Shell.Extensions.AlacrittyToggle.Toggle Alacritty alacritty"
    gsettings set "$kb_schema" binding "<Shift><Super>Return"

    e_done "GNOME configured"
}

# --------------------------------------------------------------------------------------------------
#  Main Logic
# --------------------------------------------------------------------------------------------------

main() {
    e_section "Setup Start"
    e_header "Starting setup for $OS..."

    if [ "$OS" = "Linux" ]; then
        install_system_dependencies
    fi

    install_homebrew
    install_packages
    install_viteplus
    install_docker

    configure_shell
    configure_mise
    configure_tpm

    # Deploy dotfiles
    #
    # ここで抜けると 1 つも配置されないまま「完了しました」と出る。
    # e_error は printf でしかないので、明示的に落とす必要がある。
    if ! has_command sennit; then
        e_error "sennit not found; cannot deploy"
        exit 1
    fi
    e_section "Deploying Dotfiles"
    (cd "$SCRIPT_DIR/.." && sennit apply)

    # GNOME setup must run after deploy so the extension symlink exists.
    configure_gnome

    if [ ${#FAILED_STEPS[@]} -gt 0 ]; then
        e_section "Complete with failures"
        e_error "these steps failed: ${FAILED_STEPS[*]}"
        exit 1
    fi

    e_section "Complete"
    e_done "All setup tasks completed successfully!"
}

main
