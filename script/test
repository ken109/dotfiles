#!/usr/bin/env bash
#
# script/setup の、間違えても何も言われない部分を確かめる。
#
# bash -n と shellcheck は構文しか見ない。実際に踏んだ回帰 —— 失敗を握り
# 潰す optional_step、配置より前に走らせた tpm、bash と zsh で食い違う
# XDG のパス —— はどれも構文としては正しく、リンタは 1 つも捕まえなかった。
# ここでは関数を読み込んで、外部コマンドを差し替えて、順序と終了状態を見る。

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILURES=0

ok() { printf "  \033[32mok\033[m    %s\n" "$1"; }
ng() {
    printf "  \033[31mFAIL\033[m  %s\n" "$1"
    printf "        %s\n" "$2"
    FAILURES=$((FAILURES + 1))
}

check() {
    local name="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        ok "$name"
    else
        ng "$name" "expected [$expected], got [$actual]"
    fi
}

# setup を関数として読み込み、出力と外部コマンドを潰した環境で走らせる。
# 標準出力に残すのは CALLED: の行だけにして、順序を読めるようにする。
run_setup() {
    local os="${1:-Darwin}"
    SETUP_LIB=1 OS="$os" bash -c '
        set -euo pipefail
        source "'"$SCRIPT_DIR"'/setup" >/dev/null 2>&1

        # 記録だけして何もしない差し替え
        for f in install_system_dependencies install_homebrew install_packages \
                 install_viteplus install_docker configure_shell configure_mise \
                 configure_tpm configure_gnome; do
            eval "$f() { echo \"CALLED:$f\"; }"
        done
        has_command() { [ "$1" = sennit ]; }
        # 引数まで記録する。捨てると `sennit sync` に書き換えても
        # 「配置された」と読めてしまう。sync は 0 で終わり 1 つも張らない。
        sennit() { echo "CALLED:sennit $*"; }
        e_section() { :; }
        e_header() { :; }
        e_done() { :; }
        e_error() { :; }

        main
    ' 2>/dev/null
}

echo "script/setup"

# --- 順序 ------------------------------------------------------------------
# 1 行 1 呼び出しで持つ。空白で繋ぐと `sennit apply` が 2 語に割れ、
# 位置の比較がスタブの書き方に依存してしまう。
order="$(run_setup Darwin | grep '^CALLED:' | sed 's/^CALLED://')"

if ! grep -qx 'sennit apply' <<<"$order"; then
    ng "the dotfiles are deployed" "sennit apply never ran: [$(tr '\n' ' ' <<<"$order")]"
fi

# tpm は配置のあと。プラグイン一覧も置き場も tmux.conf から読むので、
# 先に走らせると設定が無く abort する。
apply_at="$(grep -nx 'sennit apply' <<<"$order" | cut -d: -f1)"
tpm_at="$(grep -nx 'configure_tpm' <<<"$order" | cut -d: -f1)"
gnome_at="$(grep -nx 'configure_gnome' <<<"$order" | cut -d: -f1)"
if [ -n "$apply_at" ] && [ -n "$tpm_at" ] && [ "$tpm_at" -gt "$apply_at" ]; then
    ok "tpm runs after the dotfiles are deployed"
else
    ng "tpm runs after the dotfiles are deployed" "order was [$(tr '\n' ' ' <<<"$order")]"
fi
if [ -n "$apply_at" ] && [ -n "$gnome_at" ] && [ "$gnome_at" -gt "$apply_at" ]; then
    ok "gnome runs after the dotfiles are deployed"
else
    ng "gnome runs after the dotfiles are deployed" "order was [$(tr '\n' ' ' <<<"$order")]"
fi

# --- optional_step ---------------------------------------------------------
# 条件の位置に置くと errexit が無効になり、包んだ関数が失敗した行を
# 素通りして最後まで走り、0 を返す。失敗が成功に化ける。
out="$(SETUP_LIB=1 bash -c '
    set -euo pipefail
    source "'"$SCRIPT_DIR"'/setup" >/dev/null 2>&1
    e_error() { :; }
    step() { false; echo "RAN PAST THE FAILURE"; }
    optional_step thing step
    echo "recorded=${#FAILED_STEPS[@]}"
' 2>/dev/null)"
check "a wrapped step stops at its failing command" "" "$(echo "$out" | grep 'RAN PAST' || true)"
check "a wrapped failure is recorded" "recorded=1" "$(echo "$out" | grep '^recorded=')"

rc="$(SETUP_LIB=1 bash -c '
    set -euo pipefail
    source "'"$SCRIPT_DIR"'/setup" >/dev/null 2>&1
    e_error() { :; }
    step() { true; }
    optional_step thing step
    echo "recorded=${#FAILED_STEPS[@]}"
' 2>/dev/null)"
check "a wrapped step that succeeds is not recorded" "recorded=0" "$rc"

# 必須でない工程が落ちたときに、(a) 配置まで進み (b) 終了状態は 1 になるか。
#
# 終了状態だけを見てはいけない。set -e で途中死しても 1 になるので、
# 「最後にまとめて報告した」と「配置前に死んだ」を区別できない。配置が
# 走ったかどうかを順序から見る。optional_step はそのために在る。
failing_run="$(
    set +e
    SETUP_LIB=1 OS=Darwin bash -c '
        set -euo pipefail
        source "'"$SCRIPT_DIR"'/setup" >/dev/null 2>&1
        for f in install_system_dependencies install_homebrew install_packages \
                 install_viteplus configure_shell configure_mise configure_gnome \
                 configure_tpm; do
            eval "$f() { echo \"CALLED:$f\"; }"
        done
        install_docker() { echo "CALLED:install_docker"; false; }
        has_command() { [ "$1" = sennit ]; }
        # 引数まで記録する。捨てると `sennit sync` に書き換えても
        # 「配置された」と読めてしまう。sync は 0 で終わり 1 つも張らない。
        sennit() { echo "CALLED:sennit $*"; }
        e_section() { :; }; e_header() { :; }; e_done() { :; }; e_error() { :; }
        main
    ' 2>/dev/null
    echo "RC:$?"
)"
failing_order="$(echo "$failing_run" | grep '^CALLED:' | sed 's/^CALLED://')"
failing_rc="$(echo "$failing_run" | sed -n 's/^RC://p')"

if grep -qx 'sennit apply' <<<"$failing_order"; then
    ok "an optional step failing still deploys the dotfiles"
else
    ng "an optional step failing still deploys the dotfiles" \
        "sennit apply never ran: [$(tr '\n' ' ' <<<"$failing_order")]"
fi
check "a recorded failure reaches the exit status" "1" "$failing_rc"

# --- XDG -------------------------------------------------------------------
# .zshenv と食い違うと、bash で書いたものを zsh が読めない。brew trust が
# それで、インストールは通るのに次のシェルで tap が untrusted になる。
if ! command -v zsh >/dev/null; then
    printf "  \033[33mskip\033[m  XDG agreement with .zshenv (zsh is not installed)\n"
else
    for var in XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME; do
        # setup 側が落ちたら空が返る。比較は続ける —— 1 つ目で суite ごと
        # 抜けると、残りの 3 つが一度も比べられない。
        from_setup="$(SETUP_LIB=1 env -u "$var" bash -c '
            source "'"$SCRIPT_DIR"'/setup" >/dev/null 2>&1; echo "${'"$var"'-}"' 2>/dev/null || true)"
        from_zshenv="$(env -u "$var" zsh -c '
            source "'"$SCRIPT_DIR"'/../.zshenv" >/dev/null 2>&1; echo "${'"$var"'-}"' 2>/dev/null || true)"
        check "$var agrees with .zshenv" "$from_zshenv" "$from_setup"
    done
fi

echo
if [ "$FAILURES" -gt 0 ]; then
    printf " \033[31m%s check(s) failed\033[m\n" "$FAILURES"
    exit 1
fi
printf " \033[32mall checks passed\033[m\n"
